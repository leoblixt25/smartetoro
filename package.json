{
  "name": "eda",
  "private": true,
  "version": "0.1.0",
  "description": "eToro Dynamic Allocator — smart copy trading automation",
  "scripts": {
    "dev": "wrangler pages dev public --kv EDA_CONFIG",
    "deploy": "wrangler pages deploy public",
    "dev:allocator": "wrangler dev --c workers/allocator/wrangler.jsonc",
    "deploy:allocator": "wrangler deploy --c workers/allocator/wrangler.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260508.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5",
    "wrangler": "^4.90.0"
  }
}
