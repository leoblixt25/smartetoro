{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eda",
  "pages_build_output_dir": "public",
  "compatibility_date": "2026-05-01",
  "kv_namespaces": [
    {
      "binding": "EDA_CONFIG",
      "id": "eda-config",
      "preview_id": "eda-config-preview"
    }
  ],
  "vars": {
    "ETORO_API_KEY": "",
    "ETORO_USER_KEY": ""
  }
}
